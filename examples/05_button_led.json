{
  "schema_version": 1,
  "circuit_id": "05_button_led",
  "name": "Normally Open Pushbutton LED",
  "ground_node": "n0",
  "components": [
    {
      "id": "V1",
      "type": "voltage_source",
      "parameters": {
        "voltage_v": 5
      }
    },
    {
      "id": "SW1",
      "type": "button",
      "parameters": {
        "normally_closed": false,
        "pressed": true
      }
    },
    {
      "id": "R1",
      "type": "resistor",
      "parameters": {
        "resistance_ohm": 330
      }
    },
    {
      "id": "LED1",
      "type": "led",
      "parameters": {
        "forward_voltage_v": 2
      }
    }
  ],
  "nets": [
    {
      "id": "n1",
      "terminals": [
        {
          "component_id": "V1",
          "terminal": "1"
        },
        {
          "component_id": "SW1",
          "terminal": "1"
        }
      ]
    },
    {
      "id": "n2",
      "terminals": [
        {
          "component_id": "SW1",
          "terminal": "2"
        },
        {
          "component_id": "R1",
          "terminal": "1"
        }
      ]
    },
    {
      "id": "n3",
      "terminals": [
        {
          "component_id": "R1",
          "terminal": "2"
        },
        {
          "component_id": "LED1",
          "terminal": "1"
        }
      ]
    },
    {
      "id": "n0",
      "terminals": [
        {
          "component_id": "LED1",
          "terminal": "2"
        },
        {
          "component_id": "V1",
          "terminal": "2"
        }
      ]
    }
  ]
}
