      "parameters": {
        "resistance_ohm": 10000
      }
    },
    {
      "id": "PD1",
      "type": "photodiode",
      "parameters": {
        "photocurrent_a": 1e-05
      }
    }
  ],
  "nets": [
    {
      "id": "n1",
      "terminals": [
        {
          "component_id": "V1",
          "terminal": "1"
        },
        {
          "component_id": "PD1",
          "terminal": "2"
        }
      ]
    },
    {
      "id": "n2",
      "terminals": [
        {
          "component_id": "PD1",
          "terminal": "1"
        },
        {
          "component_id": "R1",
          "terminal": "1"
        }
      ]
    },
    {
      "id": "n0",
      "terminals": [
        {
          "component_id": "R1",
          "terminal": "2"
        },
        {
          "component_id": "V1",
          "terminal": "2"
        }
      ]
    }
  ]
